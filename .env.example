# Copy this file to .env and fill the required values for your environment.
# Do not commit .env or place secrets in this file.
AIOPS_ENV=
AIOPS_SERVICE_NAME=
AIOPS_VERSION=
AIOPS_LOG_LEVEL=
AIOPS_PROMETHEUS_TIMEOUT_SECONDS=
AIOPS_VERIFY_TLS=
AIOPS_MAX_QUERY_LENGTH=
AIOPS_RATE_LIMIT_PER_MINUTE=
AIOPS_AUDIT_LOG_MAX_ENTRIES=
AIOPS_EVENT_STORE_MAX_ENTRIES=
AIOPS_SLO_TARGET=
AIOPS_SLO_WINDOW_MINUTES=
AIOPS_REFRESH_SECONDS=
AIOPS_HOST=
AIOPS_PORT=

# Optional integrations: enter only real deployment-owned values.
AIOPS_PROMETHEUS_URL=
AIOPS_STATUS_QUERY=
AIOPS_ALERTMANAGER_URL=
AIOPS_METRICS_QUERY=
AIOPS_ANOMALIES_QUERY=
AIOPS_INCIDENTS_URL=
AIOPS_LOGS_URL=
AIOPS_ACTIONS_URL=
AIOPS_INSIGHTS_URL=
AIOPS_THRESHOLDS_URL=
AIOPS_LLM_URL=
AIOPS_LLM_API_KEY=
AIOPS_LLM_MODEL=

# Optional auth policy for each configured upstream. Repeat the variables for
# PROMETHEUS, ALERTMANAGER, INCIDENTS, LOGS, ACTIONS, INSIGHTS, and THRESHOLDS.
# AUTH_TYPE supports none (default), bearer, or basic; set only the matching
# credential(s). Secrets must be injected by a secret manager/environment.
# AIOPS_PROMETHEUS_AUTH_TYPE=none
# AIOPS_PROMETHEUS_BEARER_TOKEN=
# AIOPS_PROMETHEUS_USERNAME=
# AIOPS_PROMETHEUS_PASSWORD=
# Optional source-specific overrides; otherwise the global timeout/TLS values above apply.
# AIOPS_PROMETHEUS_TIMEOUT_SECONDS=5
# AIOPS_PROMETHEUS_VERIFY_TLS=true
# Example for another source:
# AIOPS_ALERTMANAGER_AUTH_TYPE=none
# AIOPS_ALERTMANAGER_BEARER_TOKEN=
# AIOPS_ALERTMANAGER_USERNAME=
# AIOPS_ALERTMANAGER_PASSWORD=
# AIOPS_ALERTMANAGER_TIMEOUT_SECONDS=5
# AIOPS_ALERTMANAGER_VERIFY_TLS=true

# Optional read-only service API key and trusted gateway secret.
# Keep both server-side; never put either value in browser JavaScript.
AIOPS_API_KEY=
AIOPS_GATEWAY_TOKEN=
# Exact same-origin URL(s); required for gateway-authenticated unsafe requests.
AIOPS_ALLOWED_ORIGINS=

# Required to enable mutating operations; approval is separate from gateway scopes.
AIOPS_APPROVAL_URL=
AIOPS_APPROVAL_API_KEY=
